# Illustrative /etc/network/interfaces fragment for a Debian/Proxmox host.
# REPLACE interface names and addresses; changing this remotely can lock you out.
auto lo
iface lo inet loopback

iface enp1s0 inet manual

auto vmbr0
iface vmbr0 inet static
    address 10.10.10.11/24
    gateway 10.10.10.1
    bridge-ports enp1s0
    bridge-stp off
    bridge-fd 0
    bridge-vlan-aware yes
    bridge-vids 10 20 30 40 50 60

# Ensure management VLAN tagging matches switch port native/tagged VLAN design.
